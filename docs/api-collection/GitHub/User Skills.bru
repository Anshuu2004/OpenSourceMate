meta {
  name: User Skills
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/github/users/{{username}}/skills?include_forks=false&ignore_noise=true&group_related=true&include_proficiency=true&refresh=false
  body: none
  auth: none
}

params:query {
  include_forks: false
  ignore_noise: true
  group_related: true
  include_proficiency: true
  refresh: false
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
